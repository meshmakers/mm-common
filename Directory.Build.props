<Project>
    <!-- Local lane hook (AB#4924): import <lane>/Octo.User.props when a checkout has one, like the other
         OctoMesh repos. It sets RestorePackagesPath=<lane>/.nuget-packages so this repo never extracts
         the lane's 999.0.0 packages into the shared ~/.nuget/packages that the other lane writes too.
         Uncommitted, per checkout; absent in CI, where this is a no-op. -->
    <PropertyGroup>
        <OctoUserPropsFilePath>$([MSBuild]::GetPathOfFileAbove('Octo.User.props', '$(MSBuildThisFileDirectory)'))</OctoUserPropsFilePath>
    </PropertyGroup>
    <Import Condition="'$(OctoUserPropsFilePath)'!='' And Exists('$(OctoUserPropsFilePath)')" Project="$(OctoUserPropsFilePath)"/>
    <PropertyGroup>
        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ImplicitUsings>true</ImplicitUsings>
        <RepositoryUrl>https://github.com/meshmakers/mm-common.git</RepositoryUrl>
        <PackageIcon>meshmakers64.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://www.meshmakers.io</PackageProjectUrl>
        <PackageTags>Octo data mesh iot</PackageTags>
        <PackageVersion Condition="'$(Configuration)'=='DebugL'">999.0.0</PackageVersion>
        <Version Condition="'$(Configuration)'=='DebugL'">999.0.0</Version>
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'DebugL' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)','README.md'))" Pack="True" PackagePath="" Visible="false" />
    </ItemGroup>
</Project>
