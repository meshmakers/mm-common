<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Common.ConfigurationTests</AssemblyName>
        <IsPackable>false</IsPackable>
        <PackageId>Meshmakers.Common.ConfigurationTests</PackageId>
